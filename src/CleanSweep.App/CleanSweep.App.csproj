<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>CleanSweep.App</RootNamespace>
    <AssemblyName>CleanSweep</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\cleansweep.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanSweep.Core\CleanSweep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\cleansweep.ico" />
    <Resource Include="Assets\cleansweep.png" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\rules\*.json">
      <Link>rules\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
