<Window x:Class="CleanSweep.App.Views.HunterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanSweep Avcı Modu"
        Icon="/Assets/cleansweep.ico"
        Width="230" Height="130"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        AllowDrop="True"
        Drop="Window_Drop"
        DragOver="Window_DragOver">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <!-- Crosshair Target Circle -->
        <Border x:Name="CrosshairBorder"
                Width="80" Height="80" CornerRadius="40"
                Background="#DD161B22"
                BorderBrush="#3B82F6" BorderThickness="3"
                Cursor="Cross"
                MouseLeftButtonDown="Crosshair_MouseLeftButtonDown"
                MouseMove="Crosshair_MouseMove"
                MouseLeftButtonUp="Crosshair_MouseLeftButtonUp"
                MouseRightButtonUp="Crosshair_MouseRightButtonUp"
                ToolTip="Sürükleyip hedef pencerenin üzerine bırakın veya bir kısayolu/exe'yi buraya sürükleyin. Geri dönmek için sağ tıklayın.">
            <Grid>
                <Ellipse Width="52" Height="52" Stroke="#3B82F6" StrokeThickness="1.5"/>
                <Ellipse Width="18" Height="18" Stroke="#22C55E" StrokeThickness="2"/>
                <Line X1="40" Y1="6" X2="40" Y2="74" Stroke="#3B82F6" StrokeThickness="1.5"/>
                <Line X1="6" Y1="40" X2="74" Y2="40" Stroke="#3B82F6" StrokeThickness="1.5"/>
            </Grid>
        </Border>

        <!-- Live Target Label -->
        <Border Background="#E60F1117" BorderBrush="#2B3544" BorderThickness="1" CornerRadius="6" Padding="8,3" Margin="0,6,0,0">
            <TextBlock x:Name="TargetLabel"
                       Text="Hedefe sürükle (Sağ tık: Çık)"
                       Foreground="#F0F6FC"
                       FontSize="11"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"/>
        </Border>
    </StackPanel>
</Window>
