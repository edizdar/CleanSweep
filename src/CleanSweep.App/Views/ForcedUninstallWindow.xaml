<Window x:Class="CleanSweep.App.Views.ForcedUninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Zorla Kaldır — Kaldırılamayan veya Bozuk Program"
        Icon="/Assets/cleansweep.ico"
        Background="{StaticResource BgPrimaryBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        Width="640" Height="450" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Zorla Kaldır (Forced Uninstall)" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Normal yollarla kaldırılamayan, kaldırıcısı bozulmuş veya listede görünmeyen uygulamaların çalışan süreçlerini kapatıp tüm artık dosya ve kayıt defteri anahtarlarını (bozuk Uninstall / MSI kayıtları dahil) derinlemesine tarar."
                       Foreground="{StaticResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,4,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="1">
            <TextBlock Text="Uygulama Adı (ör. Bandicam, Discord):" Margin="0,0,0,4"/>
            <TextBox x:Name="TxtAppName" Margin="0,0,0,10"/>

            <TextBlock Text="Kurulum Klasörü (isteğe bağlı ama derin tarama için önerilir):" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtFolder" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content="Klasör Seç..." Click="PickFolder_Click"/>
            </Grid>

            <TextBlock Text="Ana Çalıştırılabilir Dosya (.exe) (isteğe bağlı):" Margin="0,0,0,4"/>
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="TxtExe" Margin="0,0,8,0"/>
                <Button Grid.Column="1" Content=".exe Seç..." Click="PickExe_Click"/>
            </Grid>

            <TextBlock Text="Tarama Derinliği:" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <RadioButton x:Name="RbSafe" Content="Güvenli (Safe)" Margin="0,0,16,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                <RadioButton x:Name="RbModerate" Content="Orta (Moderate)" Margin="0,0,16,0" Foreground="{StaticResource TextPrimaryBrush}"/>
                <RadioButton x:Name="RbAdvanced" Content="Gelişmiş / Derin (Önerilen)" IsChecked="True" Foreground="{StaticResource TextPrimaryBrush}"/>
            </StackPanel>

            <CheckBox x:Name="ChkKillProcesses"
                      Content="Silmeden önce uygulamaya ait çalışan / kilitli süreçleri otomatik sonlandır"
                      IsChecked="True"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="İptal" Click="Cancel_Click" Margin="0,0,8,0"/>
            <Button Content="Derin Kalıntı Taraması Başlat" Style="{StaticResource DangerButton}" Click="Scan_Click"/>
        </StackPanel>
    </Grid>
</Window>
