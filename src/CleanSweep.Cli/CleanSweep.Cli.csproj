<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>CleanSweep.Cli</RootNamespace>
    <AssemblyName>cleansweep</AssemblyName>
    <ApplicationIcon>..\CleanSweep.App\Assets\cleansweep.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\CleanSweep.Core\CleanSweep.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\rules\*.json">
      <Link>rules\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
